# ESP32 SPI configuration

# Copyright (c) 2020 Espressif Systems (Shanghai) Co., Ltd.
# SPDX-License-Identifier: Apache-2.0

menuconfig ESP32_SPIM
	bool "ESP32 SPI controller driver"
	default y
	depends on DT_HAS_ESPRESSIF_ESP32_SPI_ENABLED
	help
	  Enables support for ESP32 SPI controller driver.

if ESP32_SPIM

config SPI_ESP32_INTERRUPT
	bool "ESP32 SPI interrupt mode"
	help
	  Enables interrupt support for ESP32 SPI driver.

config SPI_ESP32_DMA_BOUNCE_BYTES
	int "Static DMA bounce buffer per controller for buffers the DMA cannot reach"
	default 0
	range 0 4092
	help
	  A transfer buffer the GDMA cannot read or write -- external PSRAM,
	  an unaligned receive buffer -- is copied through a temporary buffer.
	  By default that buffer is allocated from the system heap for every
	  transfer (k_malloc of the transfer length), 16 allocations per 8 KiB
	  written to an SD card over SPI. Above 0, each controller instance
	  carries one static transmit and one static receive bounce buffer of
	  this size and uses them for every such transfer that fits; longer
	  transfers still take the heap path. 512 covers the block transfers of
	  the SD card driver (sdhc_spi) from a PSRAM page. Internal RAM: twice
	  this value per enabled controller.

config ESP32_SPI_TARGET
	bool "ESP32 SPI target mode"
	select SPI_PERIPHERAL
	select SPI_ESP32_INTERRUPT
	help
	  Enables target mode for the ESP32 SPI driver. Target
	  transactions are clocked by an external controller, so this
	  mode is interrupt driven and runs the SPI peripheral through
	  the dedicated target HAL.

if ESP32_SPI_TARGET

config SPI_ESP32_TARGET_MAX_BUFS
	int "Maximum scatter/gather buffers per target transaction"
	default 8
	help
	  Number of separate spi_buf segments that can be coalesced into a
	  single target transaction. A target frame is clocked by the
	  controller within one chip-select assertion, so the scattered
	  buffers are gathered into one contiguous FIFO transfer.

endif # ESP32_SPI_TARGET

endif # ESP32_SPIM
